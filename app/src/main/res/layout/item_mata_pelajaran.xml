<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivIkonMatkul"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/gray_light"
        android:padding="8dp"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNamaMatkul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Nama Mata Pelajaran"
        android:textColor="@color/black_soft"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivIkonMatkul"
        app:layout_constraintTop_toTopOf="@id/ivIkonMatkul" />

    <TextView
        android:id="@+id/tvDetailMatkul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="TI202 - 3 SKS"
        android:textColor="@color/gray_text"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/tvNamaMatkul"
        app:layout_constraintStart_toStartOf="@id/tvNamaMatkul"
        app:layout_constraintTop_toBottomOf="@id/tvNamaMatkul" />

    <TextView
        android:id="@+id/tvDeskripsiMatkul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="Belajar konsep dasar sampai praktik."
        android:textColor="@color/gray_text"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tvNamaMatkul"
        app:layout_constraintStart_toStartOf="@id/tvNamaMatkul"
        app:layout_constraintTop_toBottomOf="@id/tvDetailMatkul" />

</androidx.constraintlayout.widget.ConstraintLayout>
